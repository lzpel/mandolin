	"components": {
		"schemas": {
			"Device": {
				"type": "object",
				"required": [
					"name",
					"memory_used_megabytes",
					"memory_size_megabytes"
				],
				"properties": {
					"name": {
						"type": "string"
					},
					"memory_used_megabytes": {
						"type": "integer",
						"format": "int32"
					},
					"memory_size_megabytes": {
						"type": "integer",
						"format": "int32"
					}
				}
			},
			"Job": {
				"type": "object",
				"required": [
					"id",
					"id_root",
					"name",
					"status"
				],
				"properties": {
					"id": {
						"$ref": "#/components/schemas/UUID"
					},
					"id_root": {
						"$ref": "#/components/schemas/UUID"
					},
					"name": {
						"type": "string"
					},
					"status": {
						"type": "array",
						"items": {
							"$ref": "#/components/schemas/Task"
						}
					}
				}
			},
			"JobRequest": {
				"type": "object",
				"required": [
					"json",
					"image",
					"archive"
				],
				"properties": {
					"json": {
						"type": "string"
					},
					"image": {
						"type": "string"
					},
					"archive": {
						"type": "string",
						"format": "byte"
					}
				}
			},
			"Task": {
				"type": "object",
				"required": [
					"target",
					"code",
					"time_run",
					"time_end",
					"path"
				],
				"properties": {
					"target": {
						"type": "string"
					},
					"code": {
						"type": "integer",
						"format": "int32"
					},
					"time_run": {
						"type": "integer",
						"format": "int32"
					},
					"time_end": {
						"type": "integer",
						"format": "int32"
					},
					"path": {
						"type": "array",
						"items": {
							"type": "string"
						}
					}
				}
			},
			"UUID": {
				"type": "string",
				"format": "uuid"
			},
			"User": {
				"type": "object",
				"required": [
					"id",
					"name",
					"picture",
					"auth_email",
					"auth_email_password"
				],
				"properties": {
					"id": {
						"$ref": "#/components/schemas/UUID"
					},
					"name": {
						"type": "string"
					},
					"picture": {
						"type": "string"
					},
					"auth_email": {
						"type": "string"
					},
					"auth_email_password": {
						"type": "string"
					}
				}
			}
		},
		"securitySchemes": {
			"BearerAuth": {
				"type": "http",
				"scheme": "Bearer"
			}
		}
	},
	"servers": [
		{
			"url": "/api",
			"description": "開発用",
			"variables": {}
		}
	]
